[
  {
    "name": "OpenAI",
    "id": "openai",
    "keychainService": "OPENAI_API_KEY",
    "consoleUrl": "https://platform.openai.com/usage",
    "api": {
      "url": "https://api.openai.com/v1/dashboard/billing/credit_grants",
      "method": "GET",
      "authHeader": "Authorization",
      "authPrefix": "Bearer "
    },
    "parser": {
      "type": "balance",
      "fields": {
        "balance": "total_granted",
        "currency": "currency"
      }
    },
    "display": {
      "unit": "$",
      "label": "余额",
      "currencySymbols": { "USD": "$" }
    }
  },
  {
